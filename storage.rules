rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User images
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /cover_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Agency images - IMPORTANT: Add these rules
    match /agency_logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /agency_covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin-ish uploads
    match /popup/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /slider/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: public read
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}
